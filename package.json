{
  "name": "vox",
  "version": "0.2.1",
  "private": true,
  "bin": {
    "vox": "dist/cli.js"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup src/cli.ts --format esm --target node22 --sourcemap --clean",
    "start": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "pnpm run format:check && oxlint --deny-warnings src test",
    "lint:fix": "pnpm run format && oxlint --fix src test"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.3",
    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.5",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@10.34.6"
}
